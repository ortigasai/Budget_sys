# Copy this file to deploy\.env.server and fill in the real password.
# deploy\.env.server is git-ignored (see .gitignore: !deploy/.env.server.example
# is the only exception carved out of the blanket .env.* ignore) - it holds a
# real database password at rest on this laptop, so:
#   - never commit it (the .gitignore entry already stops `git add` by name,
#     but double-check with `git status` if you ever add it manually)
#   - keep this laptop's disk access to people who should have this password
#
# Once this file exists, deploy\Migrate-RemoteDb.ps1 reads it automatically
# and skips the interactive password prompt entirely - just run:
#   cd deploy
#   .\Migrate-RemoteDb.ps1
# and it applies any new Prisma/Alembic migrations straight to this server,
# every time, no typing required.
#
# Type the password exactly as it is below - do NOT try to percent-encode
# special characters (@ : / ? # % etc.) yourself. The script builds the
# actual connection strings from these separate fields and encodes the
# password automatically, the same way the interactive prompt does, so an
# @ or : in the password here is handled correctly either way.

SERVER_DATABASE_HOST=192.168.0.215
SERVER_DATABASE_PORT=5432
SERVER_DATABASE_NAME=budgeting_system
SERVER_DATABASE_USER=postgres
SERVER_DATABASE_PASSWORD=REPLACE_WITH_REAL_PASSWORD
