DATABASE_URL="postgresql://budgeting:budgeting@localhost:5432/budgeting_system?schema=public"
PORT=4000
UPLOAD_DIR=./uploads
# Shared with backend-py/.env — both services verify tokens signed with this
# same secret. Generate a real value per environment; do not reuse this example.
JWT_SECRET=replace-with-a-random-secret
# Note 11 — this backend's first server-to-server call, to fetch CC/GL names
# and NPC/IO utilization data that only backend-py owns (see lib/pyBackendClient.ts).
PY_BACKEND_URL=http://127.0.0.1:8010
# SAP Requirements integration (lib/sapBroker.ts) - Ortigas's SAP data broker
# API keys, one per report. Get real values from the Prompters API broker;
# the broker's own base URL defaults to https://paba.ortigasland.com.ph/api/v1
# (override via SAP_BROKER_BASE_URL).
FBL3N_API_KEY=replace-with-a-real-key
SALR_API_KEY=replace-with-a-real-key
KSSB_V1_API_KEY=replace-with-a-real-key
