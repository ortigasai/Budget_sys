DATABASE_URL="postgresql+psycopg://budgeting:budgeting@localhost:5432/budgeting_system"
PORT=8000
# Must match backend/.env's JWT_SECRET exactly. Generate a real value per
# environment; do not reuse this example.
JWT_SECRET=replace-with-a-random-secret
# SAP Requirements integration - Ortigas's SAP data broker API keys (see
# app/services/sap_broker.py). Get real values from the Prompters API
# broker; the broker's own base URL defaults to
# https://paba.ortigasland.com.ph/api/v1 (override via SAP_BROKER_BASE_URL).
FBL3N_API_KEY=replace-with-a-real-key
KSSB_V2_API_KEY=replace-with-a-real-key
SALR_API_KEY=replace-with-a-real-key
