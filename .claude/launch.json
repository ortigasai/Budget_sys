{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "budgeting-system-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "frontend"],
      "port": 5173
    },
    {
      "name": "budgeting-system-backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "backend"],
      "port": 4000
    },
    {
      "name": "budgeting-system-backend-py",
      "runtimeExecutable": "backend-py/venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--port", "8010", "--host", "127.0.0.1", "--app-dir", "backend-py"],
      "port": 8010
    }
  ]
}
